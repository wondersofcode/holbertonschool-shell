#!/usr/bin/env bash
# 10-process_and_pid_file

terminate_script() {
    sudo rm -f /var/run/myscript.pid
    exit 0
}


trap 'echo "I hate the kill command"; terminate_script' SIGTERM

trap 'echo "Y U no love me?!"' SIGINT


trap 'terminate_script' SIGQUIT

echo $$ | sudo tee /var/run/myscript.pid > /dev/null
while true; do
 2>/dev/null
    echo "To infinity and beyond"
    sleep 2
done
