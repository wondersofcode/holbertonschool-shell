#!/usr/bin/env bash
# Displays "To infinity and beyond" indefinitely, manages PID file and custom signals

# Cleanup function: remove PID file and exit
cleanup() {
    sudo rm -f /var/run/myscript.pid
    exit 0
}

# Signal handling
trap 'echo "Y U no love me?!"' SIGINT
trap 'echo "I hate the kill command"; cleanup' SIGTERM
trap cleanup SIGQUIT

# Create PID file
echo $$ | sudo tee /var/run/myscript.pid > /dev/null

# Infinite loop
while true; do
    echo "To infinity and beyond"
    sleep 2
done
